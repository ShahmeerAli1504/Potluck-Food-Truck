# Recipient Email for Form Submissions (Defaults to griffin@potlucknv.com)
RECIPIENT_EMAIL=griffin@potlucknv.com

# SMTP Server Settings (Nodemailer)
# Uncomment & set these variables to send live emails via any SMTP provider (Gmail Workspace, SendGrid, Mailgun, Amazon SES, cPanel, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@potlucknv.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Potluck Food Truck <noreply@potlucknv.com>"

# Alternative: Resend API Key (https://resend.com)
# RESEND_API_KEY=re_123456789
# RESEND_FROM="Potluck Web Form <onboarding@resend.dev>"
